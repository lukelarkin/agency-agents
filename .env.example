# Copy to .env (git-ignored) and fill in. Never commit the real key.
#
# Meta Model API key for Muse Spark — create one at https://dev.meta.ai/api-keys/
MODEL_API_KEY=

# Optional: override the Muse model used by scripts/use-muse.sh
# muse-spark-1.3-contributor is the discounted tier; Meta may train on your
# prompts and completions with it. Use muse-spark-1.3 to opt out.
# MUSE_MODEL=muse-spark-1.3-contributor
